# Launchpad CMS — first-run admin account (set these in Netlify, not in Git)
CMS_ADMIN_EMAIL=owner@example.com
CMS_ADMIN_PASSWORD=choose-a-long-password
CMS_ADMIN_NAME=Business Owner


# Optional — only if you are NOT using Netlify Database.
# Any Postgres connection string works (Neon, Supabase, RDS, self-hosted).
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
